# DON'T ASK ME, BECAUSE I DON'T KNOW WHY

# shellcheck shell=bash
# Every path sourced below is created by a war10ck module at install time, so
# none of them exist in the repository for shellcheck to follow, and the two
# loops name their targets through a variable.
# shellcheck disable=SC1090,SC1091

# WAR10CK BASH COMPLETION
if [ -f "/usr/local/bin/war10ck" ]; then
    . /usr/local/bin/war10ck
fi

# MODULE ENVIRONMENT
# Sourced first so PATH and exports are in place before anything that uses them.
if [ -d "$HOME/.war10ck/env.d" ]; then
    for file in "$HOME/.war10ck/env.d/"*; do
        [ -r "$file" ] && . "$file"
    done
fi

# CUSTOM ENVIRONMENT
if [ -f "$HOME/.war10ck/.environment" ]; then
    . "$HOME/.war10ck/.environment"
fi

# CUSTOM ALIASES
if [ -f "$HOME/.war10ck/.aliases" ]; then
    . "$HOME/.war10ck/.aliases"
fi

# BETTER BASH HISTORY
if [ -f "$HOME/.war10ck/.history" ]; then
    . "$HOME/.war10ck/.history"
fi

# MODULE FUNCTIONS
if [ -d "$HOME/.war10ck/functions.d" ]; then
    for file in "$HOME/.war10ck/functions.d/"*; do
        [ -r "$file" ] && . "$file"
    done
fi

# BASHRC.D
# Unmanaged by war10ck and sourced last, so anything here overrides the above.
if [ -d "$HOME/.war10ck/bashrc.d" ]; then
    for file in "$HOME/.war10ck/bashrc.d/"*; do
        [ -r "$file" ] && . "$file"
    done
fi
