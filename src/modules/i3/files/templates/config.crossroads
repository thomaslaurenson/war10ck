# Work laptop (crossroads) - host-specific overrides

# WS 1-3 on the laptop, WS 4-6 on the external (fall back to the laptop if
# unplugged). Assigned by role rather than by port: display-setup.sh always
# marks the laptop panel --primary, so any port the external lands on is
# nonprimary and the pairing holds wherever it is plugged in.
workspace 1 output primary
workspace 2 output primary
workspace 3 output primary
workspace 4 output nonprimary primary
workspace 5 output nonprimary primary
workspace 6 output nonprimary primary
